# HTTPS in front of the app on a real server (used by docker-compose.prod.yml).
# Caddy gets and renews a free Let's Encrypt certificate for DOMAIN by itself; the
# domain's DNS must point at this server and ports 80 and 443 must be open.
{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80
}
