# Private settings for Unison. Copy this file to ".env" (same folder) and fill in what you need:
#
#   cp .env.example .env
#
# docker compose reads .env by itself. .env is in .gitignore: it never goes to GitHub.
# Never put a real key or password in this example file, in docker-compose.yml or in code.
# Everything is optional on a laptop: an empty value keeps the default.

# ---------- On your laptop ----------

# AI feedback drafts: none, fake (pretend AI, no key needed), gemini or ollama.
AI_PROVIDER=none
# From https://aistudio.google.com/apikey (needs AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Google sign-in: an OAuth client from https://console.cloud.google.com
# (redirect URI: <SITE_URL>/api/v1/auth/google/callback, e.g. http://localhost:8080/api/v1/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Extra values for a real server (docs/DEPLOYMENT.md) ----------
# With APP_ENV=production the services refuse to start until the unsafe defaults are changed.

# APP_ENV=production
# DOMAIN=unison.example.org
# SITE_URL=https://unison.example.org
# AUTH_MODE=session
# COOKIE_SECURE=true
# SEED_ON_START=false
#
# 64 random characters, made with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
#
# Database passwords: set them before the very first start.
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
#
# The first administrator (asked to change the password at first login).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
#
# A mail service for real emails (Brevo shown; SendGrid, Mailgun or Gmail work the same way).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="Unison <no-reply@unison.example.org>"
