# Copy to .env only if you need to change something; docker compose works without it.
# Never commit .env: it is in .gitignore.

# Optional: Google sign-in (OAuth client from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: AI feedback drafts. AI_PROVIDER is none, gemini, ollama or fake.
AI_PROVIDER=none
GEMINI_API_KEY=

# Set a long random value on any shared server.
SECRET_KEY=
